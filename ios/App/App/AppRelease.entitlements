<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications / VoIP Push (PushKit) - produção (TestFlight / App Store).
	     Deve coincidir com o provisioning profile "Sectrum Condominio App Store" (aps-environment = production). -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
